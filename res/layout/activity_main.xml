<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ===== 页头 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="12dp">

        <TextView
            style="@style/TextEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="热点自动化" />

        <TextView
            style="@style/TextTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="蓝牙热点" />
    </LinearLayout>

    <!-- ===== 主卡片：蓝牙 → 热点 的连接示意 + 当前状态 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:background="@drawable/bg_hero"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/chipLeft"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip_icon">

                <ImageView
                    android:id="@+id/icLeft"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="个人热点"
                    android:src="@drawable/ic_stat"
                    android:tint="@color/text_tertiary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_dot" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_bt_ring">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:contentDescription="蓝牙"
                    android:src="@drawable/ic_bt"
                    android:tint="@color/text_secondary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_dot" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_dot" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/chipRight"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip_icon">

                <ImageView
                    android:id="@+id/icRight"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="车机"
                    android:src="@drawable/ic_car"
                    android:tint="@color/text_tertiary" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            style="@style/TextMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="自动开热点" />

        <TextView
            android:id="@+id/tvHeroStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="待命"
            android:textColor="@color/text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeroDesc"
            style="@style/TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="车机蓝牙连上时自动打开个人热点" />

        <Button
            android:id="@+id/btnHeroAction"
            style="@style/Btn.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="13dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="去开启无障碍" />
    </LinearLayout>

    <!-- ===== 两张行为磁贴 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="@dimen/gutter"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tileOn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tile"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_icon">

                    <ImageView
                        android:id="@+id/icTileOn"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:contentDescription="开热点"
                        android:src="@drawable/ic_power"
                        android:tint="@color/text_secondary" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="展开设置"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                android:text="连上就开热点"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOnState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="已开启"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tileOff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tile"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="13dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_icon">

                    <ImageView
                        android:id="@+id/icTileOff"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:contentDescription="延迟关闭"
                        android:src="@drawable/ic_timer"
                        android:tint="@color/text_secondary" />
                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="展开设置"
                    android:src="@drawable/ic_chevron"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                android:text="断开就关热点"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvOffState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="延迟 8 秒"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 触发设备 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/gutter"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="触发设备" />

        <TextView
            android:id="@+id/tvDevCount"
            style="@style/TextMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—" />

        <TextView
            android:id="@+id/btnRefresh"
            style="@style/TextLink"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:minHeight="0dp"
            android:paddingEnd="0dp"
            android:text="刷新" />
    </LinearLayout>

    <ListView
        android:id="@+id/listDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@drawable/div_line_inset"
        android:dividerHeight="1dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:scrollbarSize="2dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="vertical" />

    <!-- ===== 底部操作条 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_navbar"
        android:orientation="horizontal"
        android:padding="5dp">

        <LinearLayout
            android:id="@+id/navOn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_item_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavOn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="开热点"
                android:src="@drawable/ic_power"
                android:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="开热点"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navOff"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="关热点"
                android:src="@drawable/ic_power_off"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="关热点"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSet"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="设置"
                android:src="@drawable/ic_sliders"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="设置"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
